QMainWindow { background:#03070D; color:#EAF3FD; font-family:"SF Pro Display","Inter","Segoe UI",sans-serif; font-size:12px; }
QWidget { color:#EAF3FD; font-family:"SF Pro Display","Inter","Segoe UI",sans-serif; font-size:12px; }
QLabel { background:transparent; }
QFrame#Card, QFrame#ToneMasterCard, QFrame#HeaderCard { background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #091624,stop:1 #06101A); border:1px solid rgba(74,133,180,.18); border-radius:13px; }
QFrame#HeaderCard { background:#06101A; border-color:rgba(80,145,195,.18); }
QPushButton#WindowControl, QPushButton#WindowCloseControl { color:#9DB6CA; background:transparent; border:none; border-radius:8px; padding:0; font-size:20px; font-weight:400; }
QPushButton#WindowControl:hover { color:#EAF3FD; background:#132537; }
QPushButton#WindowCloseControl:hover { color:#FFFFFF; background:#C83B4A; }
QLabel#AppMark { color:#8BD9FF; font-size:23px; padding-right:8px; }
QLabel#Title { color:#D9EBFF; font-size:15px; font-weight:500; letter-spacing:3px; }
QLabel#HeaderWaveform, QLabel#ToneWaveform { color:rgba(82,231,255,.55); font-size:15px; letter-spacing:1px; }
QLabel#LicenseCaption { color:#FFD19A; background:#09111C; border:1px solid rgba(255,157,61,.42); border-radius:10px; padding:8px 18px; font-size:13px; }
QLabel#SectionPill { color:#8EA1B7; background:transparent; border:none; font-size:12px; font-weight:500; letter-spacing:2px; min-height:20px; }
QLabel#SubTitle { color:#61758C; font-size:10px; } QLabel#ToneHeading { color:#A5C8E7; font-size:13px; font-weight:500; letter-spacing:4px; }
QLabel#ToneLabel { color:#9CEAFF; font-size:48px; font-weight:600; font-style:normal; background:transparent; border:none; padding-left:10px; }
QLabel#ToneStepValue { color:#D4EAFF; font-size:28px; font-weight:600; background:#091522; border:1px solid rgba(92,150,207,.48); border-radius:10px; min-width:84px; }
QFrame#ToneShiftPanel { background:#081522; border:1px solid rgba(82,143,203,.34); border-radius:12px; }
QComboBox#SectionCombo { color:#EAF3FD; font-size:18px; font-weight:600; background:#091522; border:1px solid rgba(92,150,207,.48); border-radius:10px; padding:7px 14px; min-height:26px; }
QComboBox#SectionCombo::drop-down { border:none; width:25px; } QComboBox#SectionCombo QAbstractItemView { background:#091522; color:#EAF3FD; border:1px solid #29577D; selection-background-color:#102239; }
QProgressBar { color:#AFC2CF; border:none; border-radius:5px; background:#17283D; text-align:center; font-size:10px; } QProgressBar::chunk { border-radius:5px; background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #5BAFC8,stop:1 #78C4D7); }
QPushButton { color:#DDEBFA; background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #0B1A2A,stop:1 #07111D); border:1px solid rgba(92,150,207,.48); border-radius:10px; padding:6px; font-size:13px; font-weight:600; } QPushButton:hover { background:#102239; border-color:rgba(110,179,232,.78); } QPushButton:pressed { background:#06101B; }
QPushButton#ToneAutoButton { border-color:rgba(36,231,148,.72); color:#85FFD0; } QPushButton#ToneFixButton { border-color:rgba(255,157,61,.74); color:#FFBD68; } QPushButton#ToneEditButton { border-color:rgba(168,88,255,.76); color:#D29DFF; }
QPushButton#ToneAutoButton:!checked { border-color:rgba(255,78,97,.72); color:#FF9AA5; }
QPushButton#ToneControlButton { font-size:32px; color:#8CDFFF; border-color:#2584FF; }
QPushButton#ModeButton { background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #0A1825,stop:1 #08111D); border:1px solid rgba(82,167,255,.5); border-radius:10px; font-size:15px; font-weight:600; } QPushButton#ModeButton:checked { border-color:#52E7FF; background:#102239; }
QFrame#RotaryCell { background:transparent; border:none; border-radius:0; } QLabel#KnobCaption { color:#C6D7EA; font-size:14px; font-weight:500; } QLabel#KnobValue { font-size:20px; font-weight:600; color:#8EA1B7; }
QLabel#KnobValue[accent="violet"] { color:#C57BFF; } QLabel#KnobValue[accent="blue"] { color:#65A8FF; } QLabel#KnobValue[accent="indigo"] { color:#8C9CFF; } QLabel#KnobValue[accent="cyan"] { color:#57E8F8; } QLabel#KnobValue[accent="amber"] { color:#FFBD68; } QLabel#KnobValue[accent="magenta"] { color:#FF82DA; }
QPushButton#MonitorPrimaryButton { background:#071D1A; border-color:rgba(34,223,160,.65); color:#91FFD3; font-size:14px; } QPushButton#MonitorSecondaryButton, QPushButton#SystemSecondaryButton { border-color:rgba(37,132,255,.50); color:#B7D9FF; font-size:14px; } QPushButton#SystemPrimaryButton { background:#151027; border-color:rgba(168,88,255,.60); color:#DCB9FF; font-size:14px; } QPushButton#SystemDangerButton { background:#1A0B12; border-color:rgba(255,78,97,.60); color:#FF9AA5; font-size:14px; }
